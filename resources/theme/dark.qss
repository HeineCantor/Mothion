/* Provisional dark, compact theme. Colors come from the QPalette set in Theme.cpp;
   this file only tightens spacing. */

QMainWindow::separator {
    width: 3px;
    height: 3px;
    background: palette(dark);
}

QToolBar {
    border: none;
    spacing: 2px;
    padding: 2px;
}

QToolButton {
    padding: 2px;
    border: 1px solid transparent;
    border-radius: 3px;
}
/* With a split arrow (Onion skin, "+") the arrow gets its own room: without
   it the stylesheet draws it over the text or icon. */
QToolButton[popupMode="1"] { padding-right: 18px; }
QToolButton::menu-button {
    border: none;
    border-left: 1px solid palette(mid);
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    width: 14px;
}
QToolButton:hover   { border-color: palette(light); }
QToolButton:checked { background: palette(highlight); }
QToolButton#LayerEye:checked { background: transparent; }

/* Horizontal sliders: a thin groove, filled up to the value, and a wide, tall
   white handle with a dark gray outline, easy to grab and readable in both
   themes (the negative margin lets it stand out of the groove). */
QSlider::groove:horizontal {
    height: 4px;
    border-radius: 2px;
    background: palette(mid);
}
QSlider::sub-page:horizontal {
    height: 4px;
    border-radius: 2px;
    background: palette(highlight);
}
QSlider:horizontal { min-height: 24px; }
QSlider::handle:horizontal {
    width: 7px;
    margin: -9px 0;
    border: 1px solid #4a4a4a;
    border-radius: 3px;
    background: #ffffff;
}
QSlider::handle:horizontal:hover,
QSlider::handle:horizontal:pressed { border-color: palette(highlight); }
QSlider::handle:horizontal:disabled { background: #d8d8d8; border-color: #8a8a8a; }
QSlider::sub-page:horizontal:disabled { background: palette(mid); }

QTabBar::tab {
    padding: 2px 8px;
    min-width: 40px;
}

QLabel#PanelTitle {
    font-weight: 600;
    padding-left: 4px;
}

QWidget#PanelTitleBar {
    background: palette(mid);
}
