/* Provisional dark, compact theme. Colors come from the QPalette set in Theme.cpp;
   this file only tightens spacing. */

QMainWindow::separator {
    width: 3px;
    height: 3px;
    background: palette(dark);
}

QToolBar {
    border: none;
    spacing: 2px;
    padding: 2px;
}

QToolButton {
    padding: 2px;
    border: 1px solid transparent;
    border-radius: 3px;
}
/* With a split arrow (Onion skin, "+") the arrow gets its own room: without
   it the stylesheet draws it over the text or icon. */
QToolButton[popupMode="1"] { padding-right: 18px; }
QToolButton::menu-button {
    border: none;
    border-left: 1px solid palette(mid);
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    width: 14px;
}
QToolButton:hover   { border-color: palette(light); }
QToolButton:checked { background: palette(highlight); }
QToolButton#LayerEye:checked { background: transparent; }

/* Horizontal sliders: a thin groove, filled up to the value, and a tall vertical
   bar for the handle (the negative margin lets it stand out of the groove). */
QSlider::groove:horizontal {
    height: 4px;
    border-radius: 2px;
    background: palette(mid);
}
QSlider::sub-page:horizontal {
    height: 4px;
    border-radius: 2px;
    background: palette(highlight);
}
QSlider::handle:horizontal {
    width: 5px;
    margin: -7px 0;
    border-radius: 2px;
    background: palette(text);
}
QSlider::handle:horizontal:hover,
QSlider::handle:horizontal:pressed { background: palette(highlight); }
QSlider::handle:horizontal:disabled { background: palette(mid); }
QSlider::sub-page:horizontal:disabled { background: palette(mid); }

QTabBar::tab {
    padding: 2px 8px;
    min-width: 40px;
}

QLabel#PanelTitle {
    font-weight: 600;
    padding-left: 4px;
}

QWidget#PanelTitleBar {
    background: palette(mid);
}
